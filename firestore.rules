rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'mecanicadakar@gmail.com';
    }

    function isValidPlanAmount(amount) {
      return amount is number && amount >= 10000 && amount <= 5000000;
    }

    function isValidMembership(data) {
      return data.keys().hasAll([
          'memberNumber',
          'planId',
          'monthlyAmountGs',
          'paymentStatus',
          'paymentDate',
          'ownerName',
          'phone',
          'vehicleType',
          'vehicleModel',
          'plate',
          'joinedDate',
          'inspectionApproved',
          'monthlyScanUsed',
          'monthlyCheckUsed',
          'annualTowUsed',
          'notes',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'memberNumber',
          'planId',
          'monthlyAmountGs',
          'paymentStatus',
          'paymentDate',
          'ownerName',
          'phone',
          'vehicleType',
          'vehicleModel',
          'plate',
          'joinedDate',
          'inspectionApproved',
          'monthlyScanUsed',
          'monthlyCheckUsed',
          'annualTowUsed',
          'notes',
          'bonusDiscountGs',
          'bonusReason',
          'bonusApplied',
          'isTopTenSubscriber',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ])
        && data.memberNumber is string
        && data.memberNumber.size() >= 4
        && data.memberNumber.size() <= 24
        && data.memberNumber.matches('^[A-Z0-9-]+$')
        && data.planId is string
        && data.planId in ['basico', 'platino', 'oro']
        && isValidPlanAmount(data.monthlyAmountGs)
        && data.paymentStatus is string
        && data.paymentStatus in ['abonado', 'pendiente']
        && data.paymentDate is string
        && data.paymentDate.size() == 10
        && data.paymentDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.ownerName is string
        && data.ownerName.size() >= 3
        && data.ownerName.size() <= 120
        && data.phone is string
        && data.phone.size() >= 6
        && data.phone.size() <= 40
        && data.vehicleType is string
        && data.vehicleType in ['Automóvil', 'Camioneta', 'Utilitario']
        && data.vehicleModel is string
        && data.vehicleModel.size() >= 2
        && data.vehicleModel.size() <= 100
        && data.plate is string
        && data.plate.size() >= 4
        && data.plate.size() <= 20
        && data.plate.matches('^[A-Z0-9 -]+$')
        && data.joinedDate is string
        && data.joinedDate.size() == 10
        && data.joinedDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.inspectionApproved is bool
        && data.monthlyScanUsed is bool
        && data.monthlyCheckUsed is bool
        && data.annualTowUsed is bool
        && data.notes is string
        && data.notes.size() <= 300
        && (!('bonusDiscountGs' in data) || (data.bonusDiscountGs is number && data.bonusDiscountGs >= 0 && data.bonusDiscountGs <= 5000000))
        && (!('bonusReason' in data) || (data.bonusReason is string && data.bonusReason.size() <= 160))
        && (!('bonusApplied' in data) || data.bonusApplied is bool)
        && (!('isTopTenSubscriber' in data) || data.isTopTenSubscriber is bool)
        && data.createdByUid is string
        && data.createdByUid.size() >= 1
        && data.createdByUid.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPlanConfig(data, planId) {
      return data.keys().hasAll([
          'planId',
          'monthlyPriceGs',
          'annualFreeMonths',
          'laborDiscountPct',
          'injectorDiscountPct',
          'hasFreeOilChangeLabor',
          'hasFreeTow',
          'summary',
          'benefits',
          'updatedByUid',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'planId',
          'monthlyPriceGs',
          'annualFreeMonths',
          'laborDiscountPct',
          'injectorDiscountPct',
          'hasFreeOilChangeLabor',
          'hasFreeTow',
          'summary',
          'benefits',
          'updatedByUid',
          'updatedAt'
        ])
        && data.planId is string
        && data.planId in ['basico', 'platino', 'oro']
        && data.planId == planId
        && isValidPlanAmount(data.monthlyPriceGs)
        && data.annualFreeMonths is number
        && data.annualFreeMonths >= 0
        && data.annualFreeMonths <= 11
        && data.laborDiscountPct is number
        && data.laborDiscountPct >= 0
        && data.laborDiscountPct <= 100
        && data.injectorDiscountPct is number
        && data.injectorDiscountPct >= 0
        && data.injectorDiscountPct <= 100
        && data.hasFreeOilChangeLabor is bool
        && data.hasFreeTow is bool
        && data.summary is string
        && data.summary.size() >= 10
        && data.summary.size() <= 300
        && data.benefits is list
        && data.benefits.size() >= 1
        && data.benefits.size() <= 15
        && data.benefits[0] is string
        && data.benefits[0].size() >= 2
        && data.benefits[0].size() <= 200
        && data.updatedByUid is string
        && data.updatedByUid == request.auth.uid
        && data.updatedByUid.size() >= 1
        && data.updatedByUid.size() <= 128
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    match /memberships/{membershipId} {
      allow get: if isAdmin() && isValidId(membershipId);
      allow list: if isAdmin();

      allow create: if isAdmin()
        && isValidId(membershipId)
        && isValidMembership(incoming())
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(membershipId)
        && isValidMembership(incoming())
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'memberNumber',
          'planId',
          'monthlyAmountGs',
          'paymentStatus',
          'paymentDate',
          'ownerName',
          'phone',
          'vehicleType',
          'vehicleModel',
          'plate',
          'joinedDate',
          'inspectionApproved',
          'monthlyScanUsed',
          'monthlyCheckUsed',
          'annualTowUsed',
          'notes',
          'bonusDiscountGs',
          'bonusReason',
          'bonusApplied',
          'isTopTenSubscriber',
          'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(membershipId);
    }

    match /planConfigs/{planId} {
      allow get: if planId in ['basico', 'platino', 'oro'];

      allow create: if isAdmin()
        && isValidId(planId)
        && isValidPlanConfig(incoming(), planId);

      allow update: if isAdmin()
        && isValidId(planId)
        && isValidPlanConfig(incoming(), planId)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'planId',
          'monthlyPriceGs',
          'annualFreeMonths',
          'laborDiscountPct',
          'injectorDiscountPct',
          'hasFreeOilChangeLabor',
          'hasFreeTow',
          'summary',
          'benefits',
          'updatedByUid',
          'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(planId);
    }
  }
}
